# 复用本机已运行的 PostgreSQL，仅创建独立的 arieshub 数据库。
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 当前本机 Redis 密码。
REDIS_PASSWORD=root
# Resend API Key 与已验证的发件地址，例如 AriesHub <hello@example.com>。
RESEND_API_KEY=
RESEND_FROM=
# 首个管理员邮箱；多个邮箱使用英文逗号分隔。
ADMIN_EMAILS=

# 阿里云 OSS 的 S3 兼容入口；bucket 保持私有，使用 RAM 子账号凭据。
S3_ENABLED=false
S3_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
S3_REGION=aws-global
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_PATH_STYLE=false

# 网站公开地址，后端统一生成文章分享链接；正式环境替换为 HTTPS 域名。
SITE_URL=http://localhost:3200

# 哲学文案后台定时缓存；用户请求只读取内存，不直接调用一言。
INSPIRATION_ENABLED=true
INSPIRATION_REFRESH_MS=60000
INSPIRATION_POOL_SIZE=60
