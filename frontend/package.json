{
  "name": "arieshub-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../doc/openapi.json -o src/lib/api-schema.d.ts && prettier --write src/lib/api-schema.d.ts",
    "format": "prettier --write src e2e playwright.config.ts next.config.ts",
    "format:check": "prettier --check src e2e playwright.config.ts next.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@gsap/react": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
