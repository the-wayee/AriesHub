{
  "openapi": "3.1.0",
  "info": {
    "title": "AriesHub API",
    "version": "0.3.0",
    "description": "Public catalog, Resend email verification, cookie-based identity and administrator content API. Purchase and upload operations are not implemented."
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Checks the actual PostgreSQL connection",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database temporarily unavailable",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/email-codes": {
      "post": {
        "operationId": "sendEmailCode",
        "summary": "Sends a six-digit registration code through Resend",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmailCodeRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Registration code request accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmailCodeDispatch" }
              }
            }
          },
          "400": {
            "description": "Invalid email or purpose",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "429": {
            "description": "Code resend cooldown or rate limit reached",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "503": {
            "description": "Email delivery failed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "Creates a member account and signs it in",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created; session cookie is set",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CurrentUser" }
              }
            }
          },
          "400": {
            "description": "Invalid input or verification code",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "429": {
            "description": "Registration rate limit reached",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Signs in with email and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in; session cookie is set",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CurrentUser" }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "429": {
            "description": "Login rate limit reached",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "Returns the signed-in member",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Current member",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CurrentUser" }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Invalidates the current session",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "204": { "description": "Signed out" },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/admin/categories": {
      "get": {
        "operationId": "getAdminCategories",
        "summary": "Lists category options for the content editor",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Category options",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/AdminCategory" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/admin/cases": {
      "get": {
        "operationId": "getAdminCases",
        "summary": "Lists cases in every publication state",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "All cases",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/AdminCaseSummary" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "createAdminCase",
        "summary": "Creates a draft case and its content",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminCaseRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminCaseDetail" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/admin/cases/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/CaseId" }],
      "get": {
        "operationId": "getAdminCase",
        "summary": "Returns the complete editable case",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Editable case",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminCaseDetail" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "updateAdminCase",
        "summary": "Replaces the editable case fields and content",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminCaseRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Case updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminCaseDetail" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/admin/cases/{id}/publish": {
      "post": {
        "operationId": "publishAdminCase",
        "summary": "Publishes a case to the public catalog",
        "security": [{ "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CaseId" }],
        "responses": {
          "200": {
            "description": "Published case",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminCaseDetail" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/admin/cases/{id}/archive": {
      "post": {
        "operationId": "archiveAdminCase",
        "summary": "Archives a case and removes it from the public catalog",
        "security": [{ "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CaseId" }],
        "responses": {
          "200": {
            "description": "Archived case",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminCaseDetail" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/categories": {
      "get": {
        "operationId": "getCategories",
        "summary": "Categories with published and available case counts",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database temporarily unavailable",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/cases": {
      "get": {
        "operationId": "getCases",
        "summary": "Public case summaries; never includes body content",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CasePage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database temporarily unavailable",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24,
              "default": 9
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120,
              "description": "Trimmed literal substring matched against title/summary, case insensitive. SQL wildcards are escaped."
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{0,80}$"
            }
          },
          {
            "name": "access",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "",
                "FREE",
                "PAID"
              ]
            }
          }
        ]
      }
    },
    "/cases/{slug}": {
      "get": {
        "operationId": "getCase",
        "summary": "Public detail and preview; never includes full body",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid slug",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing, draft, archived or suspended case",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database temporarily unavailable",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,120}$"
            }
          }
        ]
      }
    },
    "/cases/{id}/content": {
      "get": {
        "operationId": "getCaseContent",
        "summary": "Only published and available FREE cases are readable in M1",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseContent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Paid content is locked; purchases are not implemented",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing, draft, archived or suspended case",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database temporarily unavailable",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "description": "PostgreSQL bigint ID serialized as a string."
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccessType": {
        "type": "string",
        "enum": [
          "FREE",
          "PAID"
        ]
      },
      "Category": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "name",
          "caseCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "PostgreSQL bigint ID serialized as a string."
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "caseCount": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "CaseSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "title",
          "summary",
          "categorySlug",
          "categoryName",
          "accessType",
          "priceMinor",
          "currency",
          "isDemo",
          "publishedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "PostgreSQL bigint ID serialized as a string."
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "categorySlug": {
            "type": "string"
          },
          "categoryName": {
            "type": "string"
          },
          "accessType": {
            "$ref": "#/components/schemas/AccessType"
          },
          "priceMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "CNY"
            ]
          },
          "isDemo": {
            "type": "boolean"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Preview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "previewMarkdown",
          "requirements",
          "deliverables",
          "version",
          "updatedAt"
        ],
        "properties": {
          "previewMarkdown": {
            "type": "string"
          },
          "requirements": {
            "type": "string"
          },
          "deliverables": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CaseDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseInfo",
          "preview"
        ],
        "properties": {
          "caseInfo": {
            "$ref": "#/components/schemas/CaseSummary"
          },
          "preview": {
            "$ref": "#/components/schemas/Preview"
          }
        }
      },
      "CaseContent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "markdown",
          "version",
          "updatedAt"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "PostgreSQL bigint ID serialized as a string."
          },
          "markdown": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CasePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "size",
          "total",
          "totalPages"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CaseSummary"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "EmailCodeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "purpose"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "purpose": { "type": "string", "enum": ["REGISTER"] }
        }
      },
      "EmailCodeDispatch": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expiresInSeconds", "resendAfterSeconds"],
        "properties": {
          "expiresInSeconds": { "type": "integer", "format": "int64", "minimum": 1 },
          "resendAfterSeconds": { "type": "integer", "format": "int64", "minimum": 1 }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password", "nickname", "code"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 72,
            "description": "Must contain at least one ASCII letter and one digit."
          },
          "nickname": { "type": "string", "minLength": 2, "maxLength": 30 },
          "code": { "type": "string", "pattern": "^[0-9]{6}$" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": { "type": "string", "format": "password", "maxLength": 72 }
        }
      },
      "AdminCategory": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slug", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]+$" },
          "slug": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "AdminCaseRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["categoryId", "slug", "title", "summary", "accessType", "priceMinor", "previewMarkdown", "fullMarkdown", "requirements", "deliverables", "version"],
        "properties": {
          "categoryId": { "type": "integer", "format": "int64", "minimum": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]{1,120}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "accessType": { "$ref": "#/components/schemas/AccessType" },
          "priceMinor": { "type": "integer", "format": "int64", "minimum": 0 },
          "previewMarkdown": { "type": "string", "minLength": 1, "maxLength": 100000 },
          "fullMarkdown": { "type": "string", "minLength": 1, "maxLength": 500000 },
          "requirements": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "deliverables": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "version": { "type": "string", "minLength": 1, "maxLength": 32 }
        }
      },
      "AdminCaseSummary": {
        "type": "object",
        "required": ["id", "slug", "title", "categoryName", "accessType", "priceMinor", "status", "deliveryStatus", "publishedAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]+$" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "categoryName": { "type": "string" },
          "accessType": { "$ref": "#/components/schemas/AccessType" },
          "priceMinor": { "type": "integer", "format": "int64", "minimum": 0 },
          "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"] },
          "deliveryStatus": { "type": "string", "enum": ["AVAILABLE", "SUSPENDED"] },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AdminCaseDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/AdminCaseSummary" },
          {
            "type": "object",
            "required": ["categoryId", "summary", "currency", "isDemo", "previewMarkdown", "fullMarkdown", "requirements", "deliverables", "version", "createdAt"],
            "properties": {
              "categoryId": { "type": "string", "pattern": "^[0-9]+$" },
              "summary": { "type": "string" },
              "currency": { "type": "string", "enum": ["CNY"] },
              "isDemo": { "type": "boolean" },
              "previewMarkdown": { "type": "string" },
              "fullMarkdown": { "type": "string" },
              "requirements": { "type": "string" },
              "deliverables": { "type": "string" },
              "version": { "type": "string" },
              "createdAt": { "type": "string", "format": "date-time" }
            }
          }
        ]
      },
      "CurrentUser": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "email", "nickname", "role", "emailVerified", "createdAt"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "PostgreSQL bigint ID serialized as a string."
          },
          "email": { "type": "string", "format": "email" },
          "nickname": { "type": "string" },
          "role": { "type": "string", "enum": ["USER", "ADMIN"] },
          "emailVerified": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "UP"
            ]
          }
        }
      }
    },
    "parameters": {
      "CaseId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "format": "int64", "minimum": 1 }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "Not signed in",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "Signed in without the ADMIN role",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Case not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Conflict": {
        "description": "Case slug already exists",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "arieshub_token"
      }
    }
  }
}
